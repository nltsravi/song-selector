# ========================================================
# Google Apps Script & Sheets Configuration Secrets
# ========================================================

# Required: Google Apps Script Script ID
# How to find your Script ID:
# 1. Open your Google Sheet -> Extensions -> Apps Script
# 2. In the Apps Script editor, click ⚙️ Project Settings on the left panel
# 3. Under "IDs", copy the "Script ID" and paste it here
SCRIPT_ID=your_script_id_here

# Required: Google Spreadsheet ID
# From URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Optional: Specific Web App Deployment ID
# To update an existing deployment without changing the URL:
# In Apps Script: Deploy -> Manage deployments -> Copy "Deployment ID"
# If left blank, clasp creates a new version/deployment.
DEPLOYMENT_ID=

# Deployment Description
DEPLOYMENT_DESC="Song Collection & Lyrics Library deployment"

# Optional: Enterprise Domain Restriction (Section 6)
REQUIRE_DOMAIN_RESTRICTION=false
ALLOWED_DOMAIN=tirwin.in
