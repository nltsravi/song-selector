{
  "name": "song-selector",
  "version": "1.0.0",
  "description": "Google Sites Song Collection & Lyrics Export Application",
  "scripts": {
    "dev": "python3 -m http.server 3000 --directory public",
    "start": "python3 -m http.server 3000 --directory public",
    "test": "node tests/test-backend.js && node tests/test-static-spa.js && node tests/test-google-oauth.js",
    "sync-songs": "node scripts/download-songs.js",
    "sync-auth": "node scripts/build-auth-config.js",
    "build": "node scripts/download-songs.js && node scripts/build-auth-config.js",
    "deploy": "node deploy.js deploy",
    "push": "node deploy.js push",
    "status": "node deploy.js status",
    "login": "node deploy.js login",
    "open": "node deploy.js open"
  },
  "keywords": [
    "google-apps-script",
    "google-sites",
    "song-library",
    "lyrics-export",
    "tamil",
    "devanagari"
  ],
  "author": "Ravishankar Jayaraman",
  "license": "MIT"
}
